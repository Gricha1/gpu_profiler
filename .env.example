# Cursor SDK agent (optional). Never commit real keys.
CURSOR_API_KEY=

# AI Coding Quotas — MiniMax M3 Coding / Token Plan (optional).
# Set this to enable the MiniMax collector. The sk-cp-… key from your
# MiniMax Token Plan or Coding Plan is the only secret needed; it lives
# only in this gitignored .env file and is never echoed back by the API.
# The collector hits the openplatform API at api.minimax.io using this
# key — no group_id, no web scraping.
# MINIMAX_API_KEY=sk-cp-REPLACE-ME

