# Cursor SDK agent (optional). Never commit real keys.
CURSOR_API_KEY=

# AI Coding Quotas — MiniMax M3 Coding / Token Plan (optional).
# Set this to enable the MiniMax collector. The sk-cp-… key from your
# MiniMax Token Plan or Coding Plan is the only secret needed; it lives
# only in this gitignored .env file and is never echoed back by the API.
# The collector hits the openplatform API at api.minimax.io using this
# key — no group_id, no web scraping.
# MINIMAX_API_KEY=sk-cp-REPLACE-ME

# Required only when administrative endpoints are exposed beyond loopback.
# Use a long random value and send it as Authorization: Bearer ... or
# X-Admin-Token. Loopback administration remains available without a token.
GPU_MONITOR_ADMIN_TOKEN=
# UI administrator password. Change this outside a trusted local network.
GPU_MONITOR_ADMIN_PASSWORD=0000

# Remote metrics scheduler and global SSH-process limiter.
GPU_MONITOR_REFRESH_SEC=15
GPU_MONITOR_BACKOFF_MAX_SEC=120
GPU_MONITOR_SSH_MAX_ACTIVE=3
