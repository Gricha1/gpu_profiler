[Unit]
Description=GPU Profiler web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/gpu_profiler
ExecStart=%h/gpu_profiler/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
