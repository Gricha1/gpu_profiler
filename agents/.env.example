# Copy to agents/.env on the monitored GPU server. Never commit this file.
GPU_FLEET_ENDPOINT=http://93.175.29.211:8000/api/agents/h200/metrics
GPU_FLEET_HOST=h200
GPU_FLEET_AGENT_TOKEN=PASTE_THE_ONE_TIME_TOKEN_FROM_GPU_FLEET
GPU_FLEET_INTERVAL_SEC=5
# Paths are inside the agent container; the GPU server root is mounted at /host.
GPU_MONITOR_PROBE_HOME=/host/home/your_user
GPU_MONITOR_PROBE_HOMES_DIR=/host/home
GPU_MONITOR_PROBE_SKIP_ALL_HOMES=1
